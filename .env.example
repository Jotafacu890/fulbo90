# ─── Neon (PostgreSQL) ───────────────────────────────────────────
# Usá un branch de Neon para desarrollo (este .env) y otro para producción (variables de Vercel).
# Sin DATABASE_URL la app usa los datos estáticos de /data (sin cuentas ni admin editable).

# Conexión con pooling (pgbouncer): la usan las consultas de la app.
DATABASE_URL="postgresql://USUARIO:CONTRASEÑA@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Conexión directa (sin "-pooler"): la usan las migraciones y el seed.
# La integración Neon ⇄ Vercel la crea como DATABASE_URL_UNPOOLED; DIRECT_URL también se acepta.
DATABASE_URL_UNPOOLED="postgresql://USUARIO:CONTRASEÑA@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# "static" | "prisma". Por defecto: prisma si hay DATABASE_URL, si no static.
DATA_SOURCE=""

# ─── Seguridad ───────────────────────────────────────────────────
# Firma de los tickets de partida (control de intentos). 32+ caracteres aleatorios. Obligatorio en producción.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=""

# Emails que reciben rol ADMIN al registrarse (separados por coma). Alternativa: npm run admin:create
ADMIN_EMAILS=""

# Protege /api/cron/daily. Vercel lo envía solo en el header Authorization de sus Cron Jobs.
CRON_SECRET=""

# ─── Sitio ───────────────────────────────────────────────────────
# URL pública (Open Graph, textos para compartir). Dominio candidato, no confirmado: https://fulbo90.com
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
